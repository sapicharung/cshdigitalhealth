@echo off
chcp 65001 >nul
cd /d "%~dp0"
title CSHOS DATACENTER - ตัวติดตั้งและตั้งค่าระบบ Auto-Sync
echo ========================================================================
echo    CSHOS DATACENTER - Chiang Saen Hospital
echo    กำลังตรวจจับข้อมูลเครื่องปลายทาง ติดตั้งไอคอน และตั้งค่า Remote...
echo ========================================================================
echo.

REM ตรวจสอบสิทธิ์ Administrator หากยังไม่มี ให้เรียกขอสิทธิ์อัตโนมัติ
net session >nul 2>&1
if %errorlevel% neq 0 (
    echo กำลังร้องขอสิทธิ์ Administrator เพื่อติดตั้งระบบ...
    powershell.exe -NoProfile -ExecutionPolicy Bypass -Command "try { Start-Process -FilePath '%~f0' -Verb RunAs } catch {}"
    exit /b
)

set "CSHOS_TEMP_PS=%TEMP%\cshos_installer_%RANDOM%.ps1"
certutil -decode "%~f0" "%CSHOS_TEMP_PS%" >nul 2>&1
if not exist "%CSHOS_TEMP_PS%" (
    powershell.exe -NoProfile -ExecutionPolicy Bypass -Command "$lines = Get-Content -LiteralPath '%~f0'; $start = $false; $b64 = ''; foreach ($l in $lines) { if ($l -match '^-+END') { break }; if ($start) { $b64 += $l.Trim() }; if ($l -match '^-+BEGIN') { $start = $true } }; if ($b64) { [IO.File]::WriteAllBytes('%CSHOS_TEMP_PS%', [Convert]::FromBase64String($b64)) }"
)
if not exist "%CSHOS_TEMP_PS%" (
    echo [ERROR] ไม่สามารถแตกไฟล์ติดตั้งชั่วคราวได้ กรุณาลองใหม่อีกครั้ง
    pause
    exit /b 1
)

powershell.exe -NoProfile -ExecutionPolicy Bypass -File "%CSHOS_TEMP_PS%"
set "PS_EXIT=%ERRORLEVEL%"
del "%CSHOS_TEMP_PS%" >nul 2>&1

echo.
echo ------------------------------------------------------------------------
echo การติดตั้งเสร็จสมบูรณ์ กดปุ่มใดๆ เพื่อปิดหน้าต่างนี้...
pause >nul
exit /b %PS_EXIT%

